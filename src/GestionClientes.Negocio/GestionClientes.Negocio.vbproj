    <OptionInfer>On</OptionInfer>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestionClientes.Entidades\GestionClientes.Entidades.vbproj" />
    <ProjectReference Include="..\GestionClientes.Datos\GestionClientes.Datos.vbproj" />
  </ItemGroup>

</Project>

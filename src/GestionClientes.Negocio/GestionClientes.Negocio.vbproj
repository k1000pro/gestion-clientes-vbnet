<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>GestionClientes.Negocio</RootNamespace>
    <AssemblyName>GestionClientes.Negocio</AssemblyName>
    <OptionStrict>On</OptionStrict>

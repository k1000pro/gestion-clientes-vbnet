<?xml version="1.0" encoding="utf-8"?>
<!--
    Transformación aplicada al publicar en configuración Release.

    Importante: estas transformaciones se aplican al PUBLICAR, no al compilar. Ejecutar en Release
    desde Visual Studio no las dispara.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <system.web>

    <!-- Compilar sin depuración: con debug="true" se desactivan optimizaciones, las peticiones
         no expiran y aumenta el consumo de memoria. -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />

    <!-- En un servidor nadie debe ver el detalle de una excepción, ni siquiera desde la propia
         máquina. El detalle queda en el registro. -->
    <customErrors xdt:Transform="SetAttributes(mode)" mode="On" />

  </system.web>

  <!--
      La cadena de conexión de producción no se versiona. Al publicar se inyecta con una
      transformación como la siguiente, o desde la configuración del servidor:

      <connectionStrings>
        <add name="GestionClientes"
             connectionString="Data Source=SERVIDOR;Initial Catalog=GestionClientesDB;User ID=...;Password=..."
             xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
      </connectionStrings>
  -->

</configuration>

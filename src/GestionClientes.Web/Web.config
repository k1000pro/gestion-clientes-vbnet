<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>

  <connectionStrings>
    <!--
      Autenticación de Windows: no hay usuario ni contraseña que almacenar en el archivo de
      configuración. Para usar autenticación de SQL Server, reemplazar Integrated Security por
      User ID y Password (ver README).
    -->
    <add name="GestionClientes"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=GestionClientesDB;Integrated Security=True;Application Name=GestionClientes"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!--
      Los validadores de Web Forms usan por defecto validación "unobtrusive", que depende de
      jQuery. Este proyecto no incluye jQuery a propósito, así que se desactiva y los validadores
      caen en el script propio de ASP.NET. Sin este ajuste, cualquier página con validadores
      responde 500 al renderizar.
    -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
  </appSettings>

  <!--
    El registro se configura aquí y no en código para poder cambiar destino, nivel y rotación sin
    recompilar. El archivo rota al llegar a 1 MB y se conservan cinco, de modo que un error
    repetido no llene el disco.
  -->
  <log4net>
    <appender name="ArchivoRotativo" type="log4net.Appender.RollingFileAppender">
      <file value="App_Data\errores.log" />
      <appendToFile value="true" />
      <rollingStyle value="Size" />
      <maxSizeRollBackups value="5" />
      <maximumFileSize value="1MB" />
      <staticLogFileName value="true" />
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline%exception" />
      </layout>
    </appender>
    <root>
      <level value="INFO" />
      <appender-ref ref="ArchivoRotativo" />
    </root>
  </log4net>

  <system.web>
    <compilation debug="true" strict="true" explicit="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" requestValidationMode="4.5" />

    <!--
      Los archivos .aspx y .master se guardan en UTF-8. Sin declararlo, ASP.NET los interpreta con
      la página de códigos del sistema y todo el texto acentuado se renderiza corrupto
      ("GestiÃ³n" en lugar de "Gestión").
    -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />

    <!--
      La autorización se declara aquí y no en el código de cada página. Con <deny users="?" />
      toda página nueva queda protegida por omisión; el patrón alternativo de comprobar la sesión
      al inicio de cada página falla el día que alguien agrega una página y olvida la comprobación.
    -->
    <authentication mode="Forms">
      <forms name=".GESTIONCLIENTES"
             loginUrl="~/Login.aspx"
             defaultUrl="~/Clientes.aspx"
             timeout="30"
             slidingExpiration="true"
             protection="All"
             cookieless="UseCookies"
             requireSSL="false" />
    </authentication>

    <authorization>
      <deny users="?" />
    </authorization>

    <sessionState mode="InProc" cookieless="UseCookies" timeout="30" />

    <!--
      RemoteOnly y no On a propósito: un cliente remoto solo ve la página genérica, pero en la
      máquina donde se ejecuta la aplicación se conserva el detalle del error. Si la instancia de
      SQL Server no coincide con la de la cadena de conexión, eso muestra el problema real en
      lugar de una página genérica que obliga a buscar el archivo de registro.
    -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" redirectMode="ResponseRewrite">
      <error statusCode="404" redirect="~/Error.aspx" />
    </customErrors>

    <pages enableViewState="true" enableViewStateMac="true" viewStateEncryptionMode="Always" />

    <httpCookies httpOnlyCookies="true" requireSSL="false" />
  </system.web>

  <!-- Recursos accesibles sin autenticación: el propio login, la página de error y los estáticos. -->
  <location path="Login.aspx">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>

  <location path="Error.aspx">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>

  <location path="Content">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>

  <location path="Scripts">
    <system.web>
      <authorization><allow users="*" /></authorization>
    </system.web>
  </location>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Clientes.aspx" />
      </files>
    </defaultDocument>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

</configuration>
